# =====================================================================
# U EPMS - Environment Configuration TEMPLATE
# Copy this file to ".env" and adjust values for your machine.
# config.php parses .env automatically on every request.
# =====================================================================

# ---- Application ----
APP_NAME=Enterprise Plant Monitoring System
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:3000
APP_TIMEZONE=Africa/Dar_es_Salaam

# ---- Database ----
# Driver: "mysql" (XAMPP / phpMyAdmin on localhost) or "sqlite" (fallback, zero-config)
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=factory_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# SQLite fallback file (relative to project root, used only when DB_DRIVER=sqlite)
DB_SQLITE_PATH=data/factory.db

# ---- Password vault ----
# 64-char hex (32 bytes). Generate a new one with:
#   php -r "echo bin2hex(random_bytes(32));"
# Changing this key makes all previously stored vault passwords unreadable.
APP_KEY=
